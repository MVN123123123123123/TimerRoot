<?xml version="1.0" encoding="utf-8" ?>
<resources>
    <!--
        Material's dark NoActionBar theme, because the whole UI is drawn in
        code on a near-black canvas. The dark parent also makes the
        AlertDialog.Builder dialogs match instead of falling back to a white
        surface when the system is in light mode.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/green</item>
    </style>
</resources>
